# HTTP server
HOST=localhost
PORT=5000
NODE_ENV=development

# PostgreSQL - runtime
PGHOST=localhost
PGUSER=developer
PGPASSWORD=supersecretpassword
PGDATABASE=forumapi
PGPORT=5432
# PGSSL=true            # set true if your PG* host requires SSL

# Alternative for hosted Postgres / Vercel deployments: a single connection
# string (e.g. from Neon, Supabase, Railway, RDS). When set, this takes
# priority over the PG* vars above and SSL is enabled automatically.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# PostgreSQL - test database (used for jest + CI)
PGHOST_TEST=localhost
PGUSER_TEST=developer
PGPASSWORD_TEST=supersecretpassword
PGDATABASE_TEST=forumapi_test
PGPORT_TEST=5432

# Token
ACCESS_TOKEN_KEY=your_access_token_secret_here
REFRESH_TOKEN_KEY=your_refresh_token_secret_here
ACCESS_TOKEN_AGE=3000
